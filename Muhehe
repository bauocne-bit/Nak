-- Tải và khởi tạo thư viện Fluent UI (Giữ lại link gốc ổn định)
local Fluent = loadstring(game:HttpGet("https://github.com"))()

-- Cấu hình Cửa sổ chính (Window)
local Window = Fluent:CreateWindow({
    Title = "Tên Script Của Bạn - Fluent UI",
    SubTitle = "bởi bauocne-bit",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = false, -- Tắt hiệu ứng mờ nền để máy Android chạy Delta X không bị lag/văng game
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- Tạo các Tab chức năng
local Tabs = {
    Main = Window:AddTab({ Title = "Trang chính", Icon = "home" }),
    Settings = Window:AddTab({ Title = "Cài đặt", Icon = "settings" })
}

-- [BƯỚC 4 cũ]: Thêm các phần tử vào Tab Trang chính
Tabs.Main:AddParagraph({
    Title = "Thông báo",
    Content = "Chào mừng bạn đã tải thành công script qua Delta X!"
})

-- Thêm Nút bấm (Button) tăng tốc độ chạy
Tabs.Main:AddButton({
    Title = "Tăng tốc độ (Speed)",
    Description = "Chỉnh WalkSpeed của bạn lên 50",
    Callback = function()
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 50
        end
    end
})

-- Thêm Công tắc (Toggle) bật/tắt Auto Farm
local Toggle = Tabs.Main:AddToggle("AutoFarmToggle", {
    Title = "Tự động đánh (Auto Farm)", 
    Default = false 
})

Toggle:OnChanged(function(Value)
    _G.AutoFarm = Value
    task.spawn(function()
        while _G.AutoFarm do
            print("Đang farm...") -- Viết logic tự động đánh của bạn ở đây
            task.wait(1)
        end
    end)
end)

-- [BƯỚC 5 cũ]: Phần quản lý giao diện cơ bản (Đã rút gọn tối đa, bỏ bớt SaveManager để tránh lỗi trên Delta X)
Tabs.Settings:AddButton({
    Title = "Tắt Menu (Destroy UI)",
    Callback = function()
        Fluent:Destroy()
    end
})

-- Chọn tab mặc định khi mở menu
Tabs.Main:Select()

-- Hiện thông báo nhỏ góc màn hình
Fluent:Notify({
    Title = "Thành công",
    Content = "Đã khởi chạy thư viện Fluent UI thành công!",
    Duration = 5
})
